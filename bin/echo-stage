#!/usr/bin/env python3
"""echo-stage — the SDLC state machine over .echo/state.json.

Subcommands:
  init  --ticket T --title "..."   Create/activate a work item at stage=intent.
  status                            Print the active item, stage, gates, next action.
  approve [--stage S]               Flip the current (or named) stage gate to approved.
  next                              Advance one stage if the current gate is approved.
  set-artifact --stage S --path P   Record an artifact path for a stage.
  set-stage --stage S               Force the active item to a stage (used by generators).

Determinism only: this never generates artifact content. `next` prints, on stdout,
the stage the caller should now generate. Exit code 2 = gate not satisfied.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import echo_common as ec  # noqa: E402


def _require_state():
    state = ec.load_state()
    if state is None:
        print("echo: not initialized in this repo. Run `/echo:intent` or "
              "`echo-stage init --ticket T --title \"...\"`.", file=sys.stderr)
        sys.exit(2)
    return state


def cmd_init(args):
    ec.ensure_dirs()
    state = ec.load_state() or ec.default_state()
    ticket = args.ticket.strip()
    if not ec.TICKET_RE.fullmatch(ticket):
        print(f"echo: '{ticket}' is not a valid Jira ticket id ([A-Z]+-[0-9]+).",
              file=sys.stderr)
        sys.exit(2)
    if ticket not in state["items"]:
        state["items"][ticket] = ec.new_item(ticket, args.title or ticket)
    state["active"] = ticket
    ec.save_state(state)
    if not os.path.exists(ec.config_path()):
        ec.save_config(dict(ec.DEFAULT_CONFIG))
    print(f"echo: active item {ticket} at stage 'intent'. "
          f"Generate intent.md, then `/echo:approve` and `/echo:next`.")


def _fmt_gates(item):
    return "  ".join(f"{s}:{item['gates'][s]}" for s in ec.GATED_STAGES)


def cmd_status(args):
    state = _require_state()
    ticket, item = ec.active_item(state)
    if not item:
        print("echo: no active item. Run `/echo:intent`.")
        return
    stage = item["stage"]
    gate = item["gates"].get(stage, "n/a")
    nxt = ec.next_stage(stage)
    print(f"Active: {ticket} — {item['title']}")
    print(f"Stage:  {stage}  (gate: {gate})")
    print(f"Gates:  {_fmt_gates(item)}")
    print(f"Artifacts: {os.path.dirname(ec.artifact_relpath(ticket, stage))}/")
    if stage == "done":
        print("Next:   done — nothing to advance.")
    elif gate != "approved":
        print(f"Next:   review the {stage} artifact, then `/echo:approve`.")
    else:
        print(f"Next:   `/echo:next` to advance to '{nxt}'.")


def cmd_approve(args):
    state = _require_state()
    ticket, item = ec.active_item(state)
    if not item:
        print("echo: no active item.", file=sys.stderr)
        sys.exit(2)
    stage = args.stage or item["stage"]
    if stage not in ec.GATED_STAGES:
        print(f"echo: stage '{stage}' has no gate.", file=sys.stderr)
        sys.exit(2)
    item["gates"][stage] = "approved"
    item["updated"] = ec.now_iso()
    ec.save_state(state)
    print(f"echo: {ticket} stage '{stage}' approved.")


def cmd_next(args):
    state = _require_state()
    ticket, item = ec.active_item(state)
    if not item:
        print("echo: no active item.", file=sys.stderr)
        sys.exit(2)
    stage = item["stage"]
    if stage == "done":
        print("echo: already done.")
        return
    if item["gates"].get(stage) != "approved":
        print(f"echo: cannot advance — stage '{stage}' gate is not approved. "
              f"Review the artifact, then `/echo:approve`.", file=sys.stderr)
        sys.exit(2)
    nxt = ec.next_stage(stage)
    if stage == "ship" and nxt == "done":
        mode = ec.load_config().get("watch_gate", "block")
        if mode != "off" and not os.path.exists(ec.watch_artifact_path(ticket)):
            if mode == "block":
                print("echo: cannot advance ship -> done - no post-ship watch recorded. "
                      "Run `/echo:watch` (or `echo-watch run`) first.", file=sys.stderr)
                sys.exit(2)
            print("echo: warning - advancing ship -> done without a watch artifact.", file=sys.stderr)
    item["stage"] = nxt
    item["updated"] = ec.now_iso()
    ec.save_state(state)
    # Tell the caller (the slash command) what to generate now.
    print(f"advanced:{nxt}")
    hints = {
        "spec": "Generate spec.md from intent.md using the spec-template skill.",
        "plan": "Generate plan.md from spec.md using the plan-template skill.",
        "build": "Plan approved. You may now write code (echo-plan-guard unblocks).",
        "test": "Run `/echo:verify` (verifier subagent) to record a passing artifact.",
        "ship": "Run `/echo:ship` to branch/commit/rebase/push/PR.",
        "done": "Loop complete.",
    }
    print(hints.get(nxt, ""))


def cmd_set_artifact(args):
    state = _require_state()
    ticket, item = ec.active_item(state)
    if not item:
        sys.exit(2)
    # Default to the ticket-scoped path so separate work items never collide.
    path = args.path or ec.artifact_relpath(ticket, args.stage)
    abspath = path if os.path.isabs(path) else os.path.join(ec.repo_root(), path)
    os.makedirs(os.path.dirname(abspath), exist_ok=True)
    item["artifacts"][args.stage] = path
    item["updated"] = ec.now_iso()
    ec.save_state(state)
    print(f"echo: recorded {args.stage} artifact -> {path}")


def cmd_set_stage(args):
    state = _require_state()
    ticket, item = ec.active_item(state)
    if not item:
        sys.exit(2)
    if args.stage not in ec.STAGES:
        print(f"echo: unknown stage '{args.stage}'.", file=sys.stderr)
        sys.exit(2)
    item["stage"] = args.stage
    item["updated"] = ec.now_iso()
    ec.save_state(state)
    print(f"echo: stage set to '{args.stage}'.")


def cmd_research_path(args):
    # Resolve the deterministic research artifact path. No state required: research
    # can precede any work item. Prints the repo-relative path and creates its dir.
    if bool(args.ticket) == bool(args.topic):
        print("echo: pass exactly one of --ticket or --topic.", file=sys.stderr)
        sys.exit(2)
    if args.ticket:
        ticket = args.ticket.strip()
        if not ec.TICKET_RE.fullmatch(ticket):
            print(f"echo: '{ticket}' is not a valid Jira ticket id ([A-Z]+-[0-9]+).",
                  file=sys.stderr)
            sys.exit(2)
        rel = ec.artifact_relpath(ticket, "research")
    else:
        rel = os.path.join(".echo", "research", ec.slugify(args.topic) + ".md")
    os.makedirs(os.path.dirname(os.path.join(ec.repo_root(), rel)), exist_ok=True)
    print(rel)


def cmd_gate_mode(args):
    # Print `stop` or `auto` for a stage under the configured autonomy level.
    # Used by /echo:flow to decide whether to pause. Fails safe to `stop`.
    stage = args.stage
    if not stage:
        state = ec.load_state()
        _, item = ec.active_item(state)
        if not item:
            print("stop")  # no active item -> pause rather than run blind
            return
        stage = item.get("stage")
    autonomy = ec.load_config().get("autonomy", "checkpoint")
    print("stop" if ec.gate_stops(autonomy, stage) else "auto")


def cmd_comment_needed(args):
    # Decide whether a Jira comment is due for <event> on the active item.
    # Prints `post <ticket>` when the active item has a valid ticket and the
    # event has not been recorded yet; prints `skip` otherwise. Always exits 0
    # so a missing state or ledger never blocks the flow (fail open).
    ticket, item = ec.active_item(ec.load_state())
    if not item or not (ticket and ec.TICKET_RE.fullmatch(ticket)):
        print("skip")
        return
    ledger = ec.load_jira_ledger(ticket)
    if args.event in ledger:
        print("skip")
    else:
        print(f"post {ticket}")


def cmd_comment_done(args):
    # Record that <event> was posted for the active item's ticket. No active
    # ticket -> exit 0 quietly (fail open).
    ticket, item = ec.active_item(ec.load_state())
    if not item or not (ticket and ec.TICKET_RE.fullmatch(ticket)):
        return
    ledger = ec.load_jira_ledger(ticket)
    ledger[args.event] = ec.now_iso()
    ec.save_jira_ledger(ticket, ledger)


def _plan_target():
    """Resolve the active item's plan artifact. Returns (abspath, text). Any
    missing piece (no active item, no recorded plan, unreadable file) yields
    (None, None) or (abspath, None) so callers can fail open."""
    state = ec.load_state()
    _, item = ec.active_item(state)
    if not item:
        return None, None
    rel = (item.get("artifacts") or {}).get("plan")
    if not rel:
        return None, None
    abspath = rel if os.path.isabs(rel) else os.path.join(ec.repo_root(), rel)
    try:
        with open(abspath, "r", encoding="utf-8") as fh:
            return abspath, fh.read()
    except OSError:
        return abspath, None


def cmd_checklist(args):
    # Fail open: no active item / no plan path / missing file / no checkboxes
    # all print `checklist: none` and exit 0.
    _, text = _plan_target()
    items = ec.parse_order_checklist(text) if text else []
    if not items:
        print("checklist: none")
        return
    done, total = ec.checklist_counts(items)
    print(f"checklist: {done}/{total} done")
    for i in items:
        mark = "x" if i["checked"] else " "
        print(f"{i['index']}. [{mark}] {i['text']}")


def _set_index(index, checked, verb):
    # Manual guard: no plan or out-of-range index is an explicit error (exit 2).
    abspath, text = _plan_target()
    if not abspath or text is None:
        print("echo: no plan artifact to update.", file=sys.stderr)
        sys.exit(2)
    items = ec.parse_order_checklist(text)
    if not (1 <= index <= len(items)):
        print(f"echo: index {index} out of range (1..{len(items)}).", file=sys.stderr)
        sys.exit(2)
    with open(abspath, "w", encoding="utf-8") as fh:
        fh.write(ec.set_checkbox(text, index, checked))
    print(f"{verb}: {index}. {items[index - 1]['text']}")


def cmd_check(args):
    _set_index(args.index, True, "checked")


def cmd_uncheck(args):
    _set_index(args.index, False, "unchecked")


def cmd_check_next(args):
    # Mark the first unchecked Order-of-work item. Fail open: no plan / no items
    # / all checked -> `checklist: nothing to check`, exit 0.
    abspath, text = _plan_target()
    items = ec.parse_order_checklist(text) if text else []
    nxt = next((i for i in items if not i["checked"]), None) if abspath else None
    if nxt is None:
        print("checklist: nothing to check")
        return
    with open(abspath, "w", encoding="utf-8") as fh:
        fh.write(ec.set_checkbox(text, nxt["index"], True))
    print(f"checked: {nxt['index']}. {nxt['text']}")


def main():
    p = argparse.ArgumentParser(prog="echo-stage")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init")
    pi.add_argument("--ticket", required=True)
    pi.add_argument("--title", default="")
    pi.set_defaults(func=cmd_init)

    sub.add_parser("status").set_defaults(func=cmd_status)

    pa = sub.add_parser("approve")
    pa.add_argument("--stage", default=None)
    pa.set_defaults(func=cmd_approve)

    sub.add_parser("next").set_defaults(func=cmd_next)

    ps = sub.add_parser("set-artifact")
    ps.add_argument("--stage", required=True)
    ps.add_argument("--path", default=None,
                    help="explicit path; omit to use the ticket-scoped default")
    ps.set_defaults(func=cmd_set_artifact)

    pss = sub.add_parser("set-stage")
    pss.add_argument("--stage", required=True)
    pss.set_defaults(func=cmd_set_stage)

    prp = sub.add_parser("research-path")
    prp.add_argument("--ticket", default=None)
    prp.add_argument("--topic", default=None)
    prp.set_defaults(func=cmd_research_path)

    pgm = sub.add_parser("gate-mode")
    pgm.add_argument("--stage", default=None)
    pgm.set_defaults(func=cmd_gate_mode)

    pcn = sub.add_parser("comment-needed")
    pcn.add_argument("--event", required=True)
    pcn.set_defaults(func=cmd_comment_needed)

    pcd = sub.add_parser("comment-done")
    pcd.add_argument("--event", required=True)
    pcd.set_defaults(func=cmd_comment_done)

    sub.add_parser("checklist").set_defaults(func=cmd_checklist)

    pck = sub.add_parser("check")
    pck.add_argument("--index", type=int, required=True)
    pck.set_defaults(func=cmd_check)

    puk = sub.add_parser("uncheck")
    puk.add_argument("--index", type=int, required=True)
    puk.set_defaults(func=cmd_uncheck)

    sub.add_parser("check-next").set_defaults(func=cmd_check_next)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
