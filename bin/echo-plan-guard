#!/usr/bin/env python3
"""echo-plan-guard — PreToolUse hook (matcher Write|Edit).

Blocks code edits until the active item has an approved plan and has reached the
build stage. Artifacts, docs, and anything under .echo/ are always allowed so the
gate never blocks writing the very artifacts that open it.

config.plan_guard: deny | warn | off
config.plan_guard_override: true temporarily allows edits (documented escape hatch).

Fails OPEN when it cannot map an active item.
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import echo_common as ec  # noqa: E402

# Paths that are always allowed (never "code" for gating purposes).
ALLOW_DIRS = (".echo/", "docs/")
ALLOW_SUFFIXES = (".md", ".markdown", ".txt")


def _payload():
    try:
        raw = sys.stdin.read() if not sys.stdin.isatty() else ""
        return json.loads(raw) if raw.strip() else {}
    except Exception:
        return {}


def _target_path(payload):
    ti = payload.get("tool_input") or {}
    return ti.get("file_path") or ti.get("path") or ""


def _is_allowed_path(path, root):
    if not path:
        return True
    rel = os.path.relpath(path, root) if os.path.isabs(path) else path
    rel = rel.replace(os.sep, "/")
    if rel.startswith(ALLOW_DIRS):
        return True
    if rel.lower().endswith(ALLOW_SUFFIXES):
        return True
    return False


def main():
    payload = _payload()

    state = ec.load_state()
    if state is None:
        sys.exit(0)  # not an echo repo -> fail open

    cfg = ec.load_config()
    mode = cfg.get("plan_guard", "deny")
    if mode == "off" or cfg.get("plan_guard_override"):
        sys.exit(0)

    ticket, item = ec.active_item(state)
    if not item:
        sys.exit(0)  # cannot map -> fail open

    stage = item.get("stage")
    plan_approved = item.get("gates", {}).get("plan") == "approved"
    build_reached = ec.STAGES.index(stage) >= ec.STAGES.index("build") if stage in ec.STAGES else False
    if plan_approved and build_reached:
        sys.exit(0)  # gate is open

    path = _target_path(payload)
    root = ec.repo_root()
    if _is_allowed_path(path, root):
        sys.exit(0)  # artifacts/docs always allowed

    msg = (f"echo plan-guard: no approved plan for {ticket} (stage '{stage}'). "
           f"Write intent -> spec -> plan and `/echo:approve` the plan first. "
           f"Override for this repo: set plan_guard_override=true in .echo/config.json.")
    if mode == "warn":
        print(msg, file=sys.stderr)
        sys.exit(0)
    # deny
    print("BLOCKED by " + msg, file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
